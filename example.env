# ============================================================
# Ambientika / Matterbridge / Portainer Deployment
# ============================================================
#
# Diese Datei enthält:
#
#   - Docker-/Host-Konfiguration
#   - Pfade
#   - Netzwerk
#   - Ports
#   - Zugangsdaten
#
# Die funktionale Ambientika-Konfiguration befindet sich in:
#
#   config.yaml
#
# ============================================================


# ============================================================
# ALLGEMEINE EINSTELLUNGEN
# ============================================================

# Zeitzone für alle Container
TZ=Europe/Berlin


# ============================================================
# DOCKER COMPOSE
# ============================================================

# Name des Compose-Projekts
COMPOSE_PROJECT_NAME=matterbridge


# ============================================================
# DOCKER MACVLAN NETZWERK
# ============================================================

# Name des bestehenden/zu erstellenden Macvlan-Netzwerks
MACVLAN_NETWORK=matter_macvlan

# Physisches Netzwerkinterface der Synology
#
# Beispiele:
#   eth0
#   ovs_eth0
#   bond0
#
MACVLAN_PARENT=ovs_eth0

# IPv4-Netzwerk
MACVLAN_SUBNET=192.168.178.0/24

# Gateway / Router
MACVLAN_GATEWAY=192.168.178.1


# ============================================================
# MATTERBRIDGE
# ============================================================

# Feste IP-Adresse für Matterbridge
MATTERBRIDGE_IP=192.168.178.242

# Persistente Matterbridge-Daten
MATTERBRIDGE_DATA=/volume1/docker/matterbridge


# ============================================================
# PORTAINER
# ============================================================

# Persistente Portainer-Daten
PORTAINER_DATA=/volume1/docker/portainer

# Portainer HTTP
PORTAINER_HTTP_PORT=9000

# Portainer HTTPS
PORTAINER_HTTPS_PORT=9443


# ============================================================
# MOSQUITTO MQTT BROKER
# ============================================================

# Host-Verzeichnis für Mosquitto
MQTT_DATA=/volume1/docker/mosquitto

# MQTT-Port auf der Synology
#
# Loxone verbindet sich mit:
#
#   SYNLOGY-IP:1883
#
MQTT_PORT=1883

# MQTT-Benutzer
#
# Dieser Benutzer wird automatisch in der Mosquitto
# Passwortdatei angelegt/aktualisiert.
#
MQTT_USER=loxone

# MQTT-Passwort
#
# BITTE unbedingt ändern!
#
MQTT_PASSWORD=HIER_EIN_STARKES_PASSWORT_EINTRAGEN


# ============================================================
# AMBIENTIKA MQTT BRIDGE
# ============================================================

# Verzeichnis für den Bridge-Quellcode
#
# Das deploy.sh Script klont bzw. aktualisiert hier das
# offizielle GitHub-Repository.
#
AMBIENTIKA_DATA=/volume1/docker/ambientika-mqtt-bridge

# Git Repository der offiziellen Ambientika MQTT Bridge
AMBIENTIKA_REPOSITORY=https://github.com/ambientika-eu/ambientika-mqtt-bridge.git

# Git Branch
AMBIENTIKA_BRANCH=main

# Name des lokal gebauten Docker Images
AMBIENTIKA_IMAGE=ambientika-mqtt-bridge:latest


# ============================================================
# AMBIENTIKA ZUGANGSDATEN
# ============================================================

# Ambientika Benutzerkonto
AMBIENTIKA_USER=DEINE_AMBIENTIKA_EMAIL

# Ambientika Passwort
AMBIENTIKA_PASS=DEIN_AMBIENTIKA_PASSWORT


# ============================================================
# AMBIENTIKA MQTT
# ============================================================

# Hostname des Mosquitto Containers.
#
# WICHTIG:
# Innerhalb des Docker-Netzwerks ist "mosquitto" korrekt.
#
MQTT_HOST=mosquitto

# MQTT-Port innerhalb des Docker-Netzwerks
MQTT_PORT=1883


# ============================================================
# DEPLOYMENT OPTIONEN
# ============================================================

# Bei "true" wird beim Update der Ambientika-Quellcode
# automatisch aus Git aktualisiert.
#
# true  = Repository aktualisieren
# false = vorhandenen Source-Code verwenden
#
AMBIENTIKA_AUTO_UPDATE=true
